{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ceventic System",
  "version": "1.0.0",
  "identifier": "com.ceventic.system",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ceventic System",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "maximized": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.convex.cloud wss://*.convex.cloud https://*.convex.site"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:5173",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173 https://fonts.googleapis.com",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 https://*.convex.cloud wss://*.convex.cloud https://*.convex.site"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your personal operating system.",
    "longDescription": "Ceventic System is a personal operating system for routines, workouts, habits, progress, Athkar, and macros.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
